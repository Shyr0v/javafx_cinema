<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cinema.controllers.AjouterCinemaController"
            stylesheets="@../css/main.css">

    <children>

        <VBox spacing="20"
              layoutX="150"
              layoutY="80"
              prefWidth="600">

            <children>

                <Label text="AJOUT D'UN CINÉMA"
                       styleClass="titre-page"/>

                <Label text="Nom du cinéma :" />
                <TextField fx:id="tfDenomination"
                           promptText="Nom du cinéma"/>

                <Label text="Adresse :" />
                <TextField fx:id="tfAdresse"
                           promptText="Adresse"/>

                <Label text="Ville :" />
                <TextField fx:id="tfVille"
                           promptText="Ville"/>

                <Label text="Franchise :" />
                <ListView fx:id="lvFranchise"
                          prefHeight="150"/>

                <VBox spacing="10">

                    <children>

                        <Button text="Enregistrer"
                                onAction="#bEnregistrerClick"
                                styleClass="btn-valider"/>

                        <Button text="Effacer"
                                onAction="#bEffacerClick"
                                styleClass="btn-annuler"/>

                        <Button text="Retour"
                                onAction="#bRetourClick"
                                styleClass="btn-retour"/>

                    </children>

                </VBox>

            </children>

        </VBox>

    </children>

</AnchorPane>