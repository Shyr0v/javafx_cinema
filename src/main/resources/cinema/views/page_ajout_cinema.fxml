<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="520.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cinema.controllers.AjouterCinemaController"
            stylesheets="@css/main.css"
            styleClass="page-background">

    <children>

        <VBox alignment="CENTER"
              prefWidth="700.0"
              prefHeight="520.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <children>

                <VBox spacing="16.0"
                      maxWidth="600.0"
                      styleClass="form-card">

                    <padding>
                        <Insets top="25.0" right="30.0" bottom="25.0" left="30.0"/>
                    </padding>

                    <children>

                        <Label text="AJOUT D'UN CINÉMA"
                               styleClass="page-title"/>

                        <Label text="Renseignez les informations du cinéma puis sélectionnez sa franchise."
                               styleClass="page-subtitle"/>

                        <VBox spacing="6">
                            <children>
                                <Label text="Nom du cinéma"
                                       styleClass="form-label"/>
                                <TextField fx:id="tfDenomination"
                                           styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox spacing="6">
                            <children>
                                <Label text="Adresse"
                                       styleClass="form-label"/>
                                <TextField fx:id="tfAdresse"
                                           promptText="Ex : 12 rue Victor Hugo"
                                           styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox spacing="6">
                            <children>
                                <Label text="Ville"
                                       styleClass="form-label"/>
                                <TextField fx:id="tfVille"
                                           promptText="Ex : Lyon"
                                           styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox spacing="6">
                            <children>
                                <Label text="Franchise"
                                       styleClass="form-label"/>
                                <ListView fx:id="lvFranchise"
                                          prefHeight="110"
                                          styleClass="form-list"/>
                            </children>
                        </VBox>

                        <HBox spacing="10">
                            <children>

                                <Button text="Enregistrer"
                                        onAction="#bEnregistrerClick"
                                        styleClass="primary-button"/>

                                <Button text="Effacer"
                                        onAction="#bEffacerClick"
                                        styleClass="secondary-button"/>

                                <Button text="Retour"
                                        onAction="#bRetourClick"
                                        styleClass="secondary-button"/>

                            </children>
                        </HBox>

                    </children>

                </VBox>

            </children>

        </VBox>

    </children>

</AnchorPane>