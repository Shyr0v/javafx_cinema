<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.QuadCurve?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="540.0"
      prefWidth="729.0"
      xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cinema.controllers.AjouterFranchiseController">
    <children>

        <!-- Menu bar -->
        <VBox layoutX="-1.0" prefHeight="48.0" prefWidth="729.0">
            <children>
                <MenuBar layoutY="1.0" prefHeight="26.0" prefWidth="729.0">
                    <menus>
                        <Menu fx:id="gestionFranchise" mnemonicParsing="false" text="Gestion franchises">
                            <graphic>
                                <ImageView fitHeight="16" fitWidth="16">
                                    <image><Image url="@../images/franchise_64x64.png" /></image>
                                </ImageView>
                            </graphic>
                            <items>
                                <MenuItem fx:id="bListeFranchise" mnemonicParsing="false" onAction="#bListFranchiseClick" text="Liste franchises" />
                                <MenuItem fx:id="bAjouterFranchise" mnemonicParsing="false" onAction="#bAjouterFranchiseClick" text="Ajouter une franchise" />
                            </items>
                        </Menu>
                        <Menu fx:id="gestionCinema" mnemonicParsing="false" text="Gestion cinémas">
                            <graphic>
                                <ImageView fitHeight="16" fitWidth="16">
                                    <image><Image url="@../images/cinema_32x32.png" /></image>
                                </ImageView>
                            </graphic>
                            <items>
                                <MenuItem fx:id="bListeCinema" mnemonicParsing="false" onAction="#bListeCinemaClick" text="Liste des cinémas" />
                                <MenuItem fx:id="bAjouterCinema" mnemonicParsing="false" onAction="#bAjouterCinemaClick" text="Ajouter un cinéma" />
                            </items>
                        </Menu>
                        <Menu fx:id="gestionSalle" mnemonicParsing="false" text="Gestion salles">
                            <graphic>
                                <ImageView fitHeight="16" fitWidth="16">
                                    <image><Image url="@../images/salle_32x32.png" /></image>
                                </ImageView>
                            </graphic>
                            <items>
                                <MenuItem fx:id="bListeSalle" mnemonicParsing="false" onAction="#bListeSalleClick" text="Liste des salles" />
                                <MenuItem fx:id="bAjouterSalle" mnemonicParsing="false" onAction="#bAjouterSalleClick" text="Ajouter une salle" />
                            </items>
                        </Menu>
                        <Menu fx:id="bAutres" mnemonicParsing="false" text="Autres">
                            <graphic>
                                <ImageView fitHeight="16" fitWidth="16">
                                    <image><Image url="@../images/info.png" /></image>
                                </ImageView>
                            </graphic>
                            <items>
                                <MenuItem fx:id="bAccueil" mnemonicParsing="false" onAction="#bAccueilClick" text="Accueil" />
                                <MenuItem fx:id="bQuitter" mnemonicParsing="false" onAction="#bQuitterClick" text="Quitter" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
            </children>
        </VBox>

        <!-- Titre -->
        <Label layoutX="0.0" layoutY="45.0" prefWidth="729.0"
               alignment="CENTER"
               text="AJOUT D'UNE NOUVELLE FRANCHISE"
               textFill="#024010">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <!-- Ligne verte -->
        <Line endX="680.0" layoutX="25.0" layoutY="88.0" startX="0.0"
              stroke="#024010" strokeWidth="2.0" />

        <!-- Nom -->
        <Label layoutX="60.0" layoutY="112.0" text="Nom :" textFill="#024010">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>
        <TextField fx:id="tfNomFranchise"
                   layoutX="220.0" layoutY="108.0"
                   prefWidth="450.0" prefHeight="35.0" />

        <!-- Siège social -->
        <Label layoutX="60.0" layoutY="168.0" text="Adresse du siège social :" textFill="#024010">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>
        <TextField fx:id="tfSiegeSocial"
                   layoutX="220.0" layoutY="164.0"
                   prefWidth="450.0" prefHeight="35.0" />

        <!-- Gérant -->
        <Label layoutX="60.0" layoutY="224.0" text="Gérant :" textFill="#024010">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>
        <ListView fx:id="lvGerantFranchise"
                  layoutX="220.0" layoutY="220.0"
                  prefWidth="450.0" prefHeight="140.0" />

        <!-- Boutons -->
        <HBox alignment="CENTER"
              layoutY="390.0"
              prefHeight="60.0"
              prefWidth="729.0"
              spacing="20.0">
            <children>
                <Button fx:id="bRetour" mnemonicParsing="false" onAction="#bRetourClick"
                        prefHeight="39.0" prefWidth="180.0" text="Retour" textFill="#024010">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Button>
                <Button fx:id="bEffacer" mnemonicParsing="false" onAction="#bEffacerClick"
                        prefHeight="39.0" prefWidth="180.0" text="Effacer" textFill="#024010">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Button>
                <Button fx:id="bEnregistrer" mnemonicParsing="false" onAction="#bEnregistrerClick"
                        prefHeight="39.0" prefWidth="180.0" text="Enregistrer" textFill="#024010">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- Demi-cercles bleus -->
        <QuadCurve controlX="18.33334732055664" controlY="-216.0"
                   endX="318.33331298828125" endY="-15.000030517578125"
                   fill="#3A3AB6" layoutX="-60.0" layoutY="555.0"
                   startX="-152.3333282470703" startY="-15.000030517578125"
                   stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
        <QuadCurve controlX="190.6666259765625" controlY="-222.33334350585938"
                   endX="85.0" endY="-16.000030517578125"
                   fill="#3A3AB6" layoutX="604.0" layoutY="555.0"
                   startX="-220.66668701171875" startY="-15.0"
                   stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />

        <!-- Logo -->
        <ImageView fitHeight="89.0" fitWidth="92.0" layoutX="41.0" layoutY="445.0"
                   pickOnBounds="true" preserveRatio="true">
            <image><Image url="@../images/cinema_logo.png" /></image>
        </ImageView>

    </children>
</Pane>
