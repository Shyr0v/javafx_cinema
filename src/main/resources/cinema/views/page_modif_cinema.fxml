<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cinema.controllers.ModifierCinemaController"
      alignment="CENTER"
      spacing="15.0"
      prefHeight="420.0"
      prefWidth="520.0">

    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0" />
    </padding>

    <children>
        <Label text="MODIFICATION D'UN CINÉMA">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <Label text="Dénomination" />
        <TextArea fx:id="taLibSec"
                  prefHeight="70.0"
                  prefWidth="350.0"
                  wrapText="true" />

        <Label text="Adresse" />
        <TextField fx:id="tfAdresse"
                   prefWidth="350.0" />

        <Label text="Ville" />
        <TextField fx:id="tfVille"
                   prefWidth="350.0" />

        <Label text="Franchise" />
        <ComboBox fx:id="cbFranchise"
                  prefWidth="350.0" />

        <!--
            Correction ligne 13 :
            ajout des champs manquants dans l'écran de modification
            pour charger toutes les informations du cinéma.
        -->

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="bEnregistrer"
                        mnemonicParsing="false"
                        onAction="#bEnregistrerClick"
                        prefWidth="180.0"
                        text="ENREGISTRER" />

                <Button fx:id="bRetour"
                        mnemonicParsing="false"
                        onAction="#bRetourClick"
                        prefWidth="180.0"
                        text="RETOUR" />
            </children>
        </HBox>
    </children>
</VBox>